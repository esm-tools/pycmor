# Daily tasmax from a9kk (EC-Earth4 OIFS, XIOS, reduced Gaussian).
# Rendered by run.sh (case a9kk_day); @...@ are filled from its environment.
# Content paths explicit, never from cache or download; identity as ecemor
# examples/a9kk-test.yaml.
general:
  name: "ecearth4-a9kk-day"
  cmor_version: "CMIP7"
  mip: "CMIP"
  CMIP7_DReq_metadata: "@METADATA@"
  CV_Dir: "@SRC@/CMIP7-CVs"
  CMIP_Tables_Dir: "@SRC@/src/pycmor/data/cmip7"

pycmor:
  enable_output_subdirs: true
  warn_on_no_rule: false
  parallel: false
  dask_cluster: "local"
  # Small local cluster; the default takes the whole node (cores and memory).
  dask_n_workers: 1
  dask_threads_per_worker: 4
  dask_memory_limit: "16GB"

pipelines:
  - name: ecearth4_oifs_reduced_daily_stat
    steps:
      - pycmor.core.gather_inputs.load_mfdataset
      - pycmor.std_lib.generic.get_variable
      - script://@SRC@/ecearth4/steps.py:reduced_to_regular
      - script://@SRC@/ecearth4/steps.py:daily_statistic_time
      - pycmor.std_lib.add_vertical_bounds
      - pycmor.std_lib.timeaverage.timeavg
      - pycmor.std_lib.set_time_bounds
      - pycmor.std_lib.units.handle_unit_conversion
      - pycmor.std_lib.attributes.set_global
      - pycmor.std_lib.attributes.set_variable
      - pycmor.std_lib.attributes.set_coordinates
      - pycmor.std_lib.dimensions.map_dimensions
      - pycmor.std_lib.generic.trigger_compute
      - pycmor.std_lib.files.save_dataset

inherit:
  source_id: EC-Earth4
  institution_id: EC-Earth-Consortium
  activity_id: CMIP
  experiment_id: historical
  variant_label: r1i1p1f1
  parent_experiment_id: piControl
  parent_activity_id: CMIP
  parent_time_units: "days since 1850-01-01"
  branch_time_in_parent: 0.0
  grid_label: g114
  grid: "regular Gaussian N128 from OIFS TL255 reduced Gaussian"
  nominal_resolution: "100 km"
  time_dimname: time_counter
  calendar: gregorian
  qc_enabled: false
  output_directory: "@OUT@"

rules:
  # OIFS daily maximum, written once a day as XIOS instant (a9kk predates
  # ecearth4 8159445); a real daily extreme, not a snapshot.
  - name: tasmax
    inputs:
      - path: "@SAMPLES@/a9kk"
        pattern: a9kk_atm_cmip6_1d_.*\.nc
    compound_name: atmos.tas.tmax-h2m-hxy-u.day.glb
    model_variable: tasmax
    daily_statistic: true
    pipelines: [ecearth4_oifs_reduced_daily_stat]
