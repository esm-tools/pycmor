# OIFS surface variables for any EC-Earth4 run (XIOS, reduced Gaussian):
# run.sh run oifs_core <exp>; input <exp output>/<leg>/oifs/<exp>_atm_cmip6_1m_*.nc
# and _1d_*.nc, all legs found. Rendered by run.sh; @...@ from its environment.
# mon tas, pr, psl, tasmax, tasmin; day tas, tasmax, tasmin. Day tas assumes
# daily means in the 1d file.
general:
  name: "ecearth4-@EXP@-oifs-core"
  cmor_version: "CMIP7"
  mip: "CMIP"
  CMIP7_DReq_metadata: "@METADATA@"
  CV_Dir: "@SRC@/CMIP7-CVs"
  CMIP_Tables_Dir: "@SRC@/src/pycmor/data/cmip7"

pycmor:
  enable_output_subdirs: true
  warn_on_no_rule: false
  parallel: false
  dask_cluster: "local"
  # Small local cluster; the default takes the whole node (cores and memory).
  dask_n_workers: 1
  dask_threads_per_worker: 4
  dask_memory_limit: "16GB"

pipelines:
  - name: oifs_reduced
    steps:
      - pycmor.core.gather_inputs.load_mfdataset
      - pycmor.std_lib.generic.get_variable
      - script://@SRC@/examples/custom_steps.py:reduced_to_regular
      - pycmor.std_lib.add_vertical_bounds
      - pycmor.std_lib.timeaverage.timeavg
      - pycmor.std_lib.set_time_bounds
      - pycmor.std_lib.units.handle_unit_conversion
      - pycmor.std_lib.attributes.set_global
      - pycmor.std_lib.attributes.set_variable
      - pycmor.std_lib.attributes.set_coordinates
      - pycmor.std_lib.dimensions.map_dimensions
      - pycmor.std_lib.generic.trigger_compute
      - pycmor.std_lib.files.save_dataset
  - name: oifs_reduced_daily_stat
    steps:
      - pycmor.core.gather_inputs.load_mfdataset
      - pycmor.std_lib.generic.get_variable
      - script://@SRC@/examples/custom_steps.py:reduced_to_regular
      - script://@SRC@/examples/custom_steps.py:daily_statistic_time
      - pycmor.std_lib.add_vertical_bounds
      - pycmor.std_lib.timeaverage.timeavg
      - pycmor.std_lib.set_time_bounds
      - pycmor.std_lib.units.handle_unit_conversion
      - pycmor.std_lib.attributes.set_global
      - pycmor.std_lib.attributes.set_variable
      - pycmor.std_lib.attributes.set_coordinates
      - pycmor.std_lib.dimensions.map_dimensions
      - pycmor.std_lib.generic.trigger_compute
      - pycmor.std_lib.files.save_dataset

inherit:
  source_id: EC-Earth4
  institution_id: EC-Earth-Consortium
  activity_id: CMIP
  experiment_id: historical
  variant_label: r1i1p1f1
  parent_experiment_id: piControl
  parent_activity_id: CMIP
  parent_time_units: "days since 1850-01-01"
  branch_time_in_parent: 0.0
  grid_label: g114
  grid: "regular Gaussian N128 from OIFS TL255 reduced Gaussian"
  nominal_resolution: "100 km"
  time_dimname: time_counter
  calendar: gregorian
  qc_enabled: false
  output_directory: "@OUT@"

rules:
  - name: tas_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/oifs/@EXP@_atm_cmip6_1m_*.nc"
    compound_name: atmos.tas.tavg-h2m-hxy-u.mon.glb
    model_variable: tas
    pipelines: [oifs_reduced]
  - name: pr_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/oifs/@EXP@_atm_cmip6_1m_*.nc"
    compound_name: atmos.pr.tavg-u-hxy-u.mon.glb
    model_variable: pr
    pipelines: [oifs_reduced]
  - name: psl_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/oifs/@EXP@_atm_cmip6_1m_*.nc"
    compound_name: atmos.psl.tavg-u-hxy-u.mon.glb
    model_variable: psl
    pipelines: [oifs_reduced]
  # Monthly mean of the daily extremes OIFS computes (XIOS average of a
  # value sent once a day).
  - name: tasmax_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/oifs/@EXP@_atm_cmip6_1m_*.nc"
    compound_name: atmos.tas.tmaxavg-h2m-hxy-u.mon.glb
    model_variable: tasmax
    pipelines: [oifs_reduced]
  - name: tasmin_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/oifs/@EXP@_atm_cmip6_1m_*.nc"
    compound_name: atmos.tas.tminavg-h2m-hxy-u.mon.glb
    model_variable: tasmin
    pipelines: [oifs_reduced]
  - name: tas_day
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/oifs/@EXP@_atm_cmip6_1d_*.nc"
    compound_name: atmos.tas.tavg-h2m-hxy-u.day.glb
    model_variable: tas
    pipelines: [oifs_reduced]
  # Daily extremes computed by OIFS, written once a day as XIOS instant.
  - name: tasmax_day
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/oifs/@EXP@_atm_cmip6_1d_*.nc"
    compound_name: atmos.tas.tmax-h2m-hxy-u.day.glb
    model_variable: tasmax
    daily_statistic: true
    pipelines: [oifs_reduced_daily_stat]
  - name: tasmin_day
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/oifs/@EXP@_atm_cmip6_1d_*.nc"
    compound_name: atmos.tas.tmin-h2m-hxy-u.day.glb
    model_variable: tasmin
    daily_statistic: true
    pipelines: [oifs_reduced_daily_stat]
