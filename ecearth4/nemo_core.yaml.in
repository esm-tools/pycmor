# NEMO and SI3 core variables for any EC-Earth4 run (XIOS, eORCA1):
# run.sh run nemo_core <exp>; input <exp output>/<leg>/nemo/<exp>_oce_1m_T_*.nc,
# _oce_1m_U_*.nc, _ice_1m_*.nc, all legs found; grid from the domain file in
# NEMO_DOMAIN. Rendered by run.sh; @...@ from its environment.
# mon tos, thetao, tauuo (along the grid x axis), siconc; fx areacello.
general:
  name: "ecearth4-@EXP@-nemo-core"
  cmor_version: "CMIP7"
  mip: "CMIP"
  CMIP7_DReq_metadata: "@METADATA@"
  CV_Dir: "@SRC@/CMIP7-CVs"
  CMIP_Tables_Dir: "@SRC@/src/pycmor/data/cmip7"

pycmor:
  enable_output_subdirs: true
  warn_on_no_rule: false
  parallel: false
  dask_cluster: "local"
  # Small local cluster; the default takes the whole node (cores and memory).
  dask_n_workers: 1
  dask_threads_per_worker: 4
  dask_memory_limit: "16GB"

pipelines:
  - name: nemo_orca
    steps:
      - pycmor.core.gather_inputs.load_mfdataset
      - pycmor.std_lib.generic.get_variable
      - script://@SRC@/examples/custom_steps.py:orca_grid
      - pycmor.std_lib.timeaverage.timeavg
      - pycmor.std_lib.set_time_bounds
      - pycmor.std_lib.units.handle_unit_conversion
      - pycmor.std_lib.attributes.set_global
      - pycmor.std_lib.attributes.set_variable
      - pycmor.std_lib.attributes.set_coordinates
      - pycmor.std_lib.dimensions.map_dimensions
      - pycmor.std_lib.generic.trigger_compute
      - script://@SRC@/examples/custom_steps.py:orca_vertices
      - pycmor.std_lib.files.save_dataset
  - name: nemo_orca_fx
    steps:
      - script://@SRC@/examples/custom_steps.py:load_gridfile
      - script://@SRC@/examples/custom_steps.py:orca_cell_area
      - script://@SRC@/examples/custom_steps.py:orca_grid
      - pycmor.std_lib.set_time_bounds
      - pycmor.std_lib.attributes.set_global
      - pycmor.std_lib.attributes.set_variable
      - pycmor.std_lib.attributes.set_coordinates
      - pycmor.std_lib.dimensions.map_dimensions
      - pycmor.std_lib.generic.trigger_compute
      - script://@SRC@/examples/custom_steps.py:orca_vertices
      - pycmor.std_lib.files.save_dataset

inherit:
  source_id: EC-Earth4
  institution_id: EC-Earth-Consortium
  activity_id: CMIP
  experiment_id: historical
  variant_label: r1i1p1f1
  parent_experiment_id: piControl
  parent_activity_id: CMIP
  parent_time_units: "days since 1850-01-01"
  branch_time_in_parent: 0.0
  # eORCA1 360 x 331 in the EMD: h117 with g147 (T), g148 (U), g149 (V).
  grid_label: g147
  grid: "native eORCA1 tripolar, 360 x 331, 75 levels"
  nominal_resolution: "100 km"
  time_dimname: time_counter
  calendar: gregorian
  qc_enabled: false
  output_directory: "@OUT@"
  orca_domain: "@NEMO_DOMAIN@"

rules:
  - name: tos_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/nemo/@EXP@_oce_1m_T_*.nc"
    compound_name: ocean.tos.tavg-u-hxy-sea.mon.glb
    model_variable: tos
    pipelines: [nemo_orca]
  - name: thetao_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/nemo/@EXP@_oce_1m_T_*.nc"
    compound_name: ocean.thetao.tavg-ol-hxy-sea.mon.glb
    model_variable: thetao
    dimension_mapping:
      deptht: olevel
    pipelines: [nemo_orca]
  - name: tauuo_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/nemo/@EXP@_oce_1m_U_*.nc"
    compound_name: ocean.tauuo.tavg-u-hxy-sea.mon.glb
    model_variable: tauuo
    orca_point: U
    grid_label: g148
    pipelines: [nemo_orca]
  - name: siconc_mon
    inputs:
      - path: "@OUTPUT@"
        pattern: "*/nemo/@EXP@_ice_1m_*.nc"
    compound_name: seaIce.siconc.tavg-u-hxy-u.mon.glb
    model_variable: siconc
    pipelines: [nemo_orca]
  - name: areacello_fx
    inputs:
      - path: "@NEMO_DOMAIN_DIR@"
        pattern: "@NEMO_DOMAIN_NAME@"
    compound_name: ocean.areacello.ti-u-hxy-u.fx.glb
    model_variable: areacello
    grid_file: "@NEMO_DOMAIN@"
    pipelines: [nemo_orca_fx]
